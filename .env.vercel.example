# 2. JWT Authentication Secret Key
JWT_SECRET=serenemind_secure_jwt_production_secret_key_2026

# 3. OpenRouter AI API Key (from openrouter.ai)
serenemind=your_openrouter_api_key_here

# 4. OpenRouter Model Configuration (Optional - defaults shown)
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-preview:free
OPENROUTER_MAX_RETRIES=2
OPENROUTER_RETRY_DELAY_MS=400

# 5. Frontend API Base Path
VITE_API_URL=/api

# 6. Initial Admin Account (seeded on first boot only when the Admins table is empty)
# In production (NODE_ENV=production) seeding is ONLY allowed when ADMIN_PASSWORD is
# explicitly set to a strong value (>= 8 chars). Without it the admin account is NOT
# created and the server logs a loud warning. The known default password below is
# used ONLY in local development (NODE_ENV unset/'development') — never in production.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@serenemind.app
# ADMIN_PASSWORD=<REQUIRED in production — no default. Use a strong unique value.>
# ADMIN_FULL_NAME=Platform Administrator
